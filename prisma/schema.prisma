// ============================================================
//  CultuRésa — Schéma Prisma (PostgreSQL)
//  Porté depuis l'ancien schéma MySQL (install/culturesa.sql).
// ============================================================

generator client {
  // Prisma 7 : client Rust-free (généré dans le projet, importé via @/generated/prisma).
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  Enums
// ============================================================

enum Role {
  utilisateur
  gestionnaire
  administrateur
}

enum ThemesMode {
  libre
  liste
}

enum SlotType {
  recurring
  unique
}

enum BookingType {
  recurring
  unique
}

// Type d'exercice : année CIVILE (calendaire, ex. « 2025 » 01/01→31/12) ou
// SCOLAIRE (ex. « 2025-2026 » 01/09→31/08). Pilote le libellé + les dates par défaut.
enum ExerciceType {
  civile
  scolaire
}

enum Pointage {
  present
  absent
}

// Mode de notification des gestionnaires (digest des auto-validations).
// `each` = « Unitaires » : un e-mail par réservation, sans regroupement ni attente
// d'échéance — le seul mode où rien ne s'accumule.
enum MgrNoticeMode {
  none
  each
  hours
  daily
  weekly
}

// Jour de la semaine d'un créneau récurrent (modèle « un slot = un jour »).
enum DayOfWeek {
  lun
  mar
  mer
  jeu
  ven
  sam
  dim
}

// ============================================================
//  Authentification — Better Auth
//  (remplace les anciennes tables sessions/email_confirmations/
//   password_reset_requests/email_change_requests/auth_attempts/
//   account_deletion_requests : gérées par Better Auth + plugins)
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String   @default("")
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  // ── Champs métier (additionalFields Better Auth) ──
  prenom           String    @default("")
  nom              String    @default("")
  tel              String    @default("")
  niveau           String    @default("")
  enfants          Int       @default(0) @db.SmallInt
  accompagnants    Int       @default(0) @db.SmallInt
  role             Role      @default(utilisateur)
  rgpdOk           Boolean   @default(false)
  // Second facteur actif ? (constat A6) Piloté par le plugin twoFactor de Better
  // Auth, qui le déclare `input: false` : aucune requête ne peut donc le modifier,
  // seul l'enrôlement vérifié le bascule.
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  // Onboarding : date de complétion de la modale de bienvenue (null = jamais vue).
  onboardedAt      DateTime? @db.Timestamptz

  demandeurId Int?
  structureId Int?
  demandeur   Demandeur? @relation(fields: [demandeurId], references: [id], onDelete: SetNull)
  structure   Structure? @relation(fields: [structureId], references: [id], onDelete: SetNull)

  // ── RGPD / rétention ──
  lastLoginAt          DateTime? @db.Timestamptz
  anonymizedAt         DateTime? @db.Timestamptz
  deletionNoticeSentAt DateTime? @db.Timestamptz

  sessions        Session[]
  accounts        Account[]
  bookings        Booking[]
  managedServices ServiceManager[]
  twoFactors      TwoFactor[]

  @@index([demandeurId])
  @@index([structureId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

// ============================================================
//  Domaine métier
// ============================================================

model Service {
  id                  String   @id
  label               String
  validationBloquante Boolean  @default(true)
  // (Les maximums de réservation — par période, par an — vivent sur CHAQUE
  // EXERCICE, comme les réglages d'ouverture.)
  position            Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz

  // Capacité (places) par défaut des créneaux du service.
  // (Les réglages d'ouverture — plages, jours actifs, fériés, vacances — vivent
  // désormais sur CHAQUE EXERCICE, cf. Exercice + opening.ts. L'ex-colonne
  // `duration`, jamais lue, a été supprimée — audit 2026-07-24.)
  capacity              Int        @default(1)
  icon                  String?
  // (Le « délai limite de réservation » est désormais porté PAR EXERCICE, cf. Exercice.)
  showPreviousExercices Boolean    @default(false)
  // Le service propose des créneaux RÉCURRENTS (vue « Modèle de période » de
  // l'agenda admin). Réglage GLOBAL du service — l'ex-colonne « Mode »
  // (recurrent/ponctuel) de la matrice demandeurs a été supprimée : le type d'une
  // réservation découle du TYPE DU CRÉNEAU, plus du demandeur.
  recurrentMode         Boolean    @default(true)
  // Alternance Semaine A / B des créneaux récurrents. GLOBAL au service (ex-colonne
  // semaineAb de la matrice) ; sans effet si recurrentMode est désactivé.
  semaineAb             Boolean    @default(false)
  themesMode            ThemesMode @default(libre)
  // Jauge : compter (ou non) les accompagnants dans les places consommées.
  // true par défaut = comportement historique (enfants + accompagnants).
  gaugeAccompagnants    Boolean    @default(true)

  // Réglages du mode « Création de créneau » de l'agenda, mémorisés d'une visite à
  // l'autre. Comme `capacity`, ce sont des défauts DU SERVICE (partagés par ses
  // gestionnaires), pas des préférences de poste.
  //   createKind         : sélecteur de type de créneau ("rec" | "uniq" | "multi").
  //   createParityScoped : sélecteur Semaine A/B (sans effet hors service A/B).
  //   createJauge        : mode jauge des créneaux créés.
  //   createDemandeurIds : demandeurs autorisés par défaut (vide = ouvert à tous).
  //     Pas de FK possible sur un tableau : la liste est filtrée contre le
  //     référentiel à la lecture, un demandeur supprimé n'y laisse qu'un id mort.
  createKind         String  @default("uniq")
  createParityScoped Boolean @default(false)
  createJauge        Boolean @default(false)
  createDemandeurIds Int[]   @default([])

  // Délai d'auto-validation en minutes SIGNÉES (cf. services/auto-validate.ts).
  //   0 = jamais ; négatif = N minutes OUVRÉES (jours actifs ∩ plages) ;
  //   positif = N minutes calendaires après `booking.autoValidateFrom`.
  autoValidationDelay Int @default(0)

  // Notification des gestionnaires sur les auto-validations (digest par service).
  //   cf. services/manager-notice.ts.
  mgrNoticeMode          MgrNoticeMode @default(none)
  mgrNoticeIntervalHours Int           @default(4)
  mgrNoticeHour          Int           @default(8)
  mgrNoticeWeekday       DayOfWeek     @default(lun)
  mgrNoticeLastSentAt    DateTime?     @db.Timestamptz

  slots             Slot[]
  periods           Period[]
  exercices         Exercice[]
  cycleEvents       CycleEvent[]
  themes            ServiceTheme[]
  demandeurSettings ServiceDemandeurSettings[]
  bookings          Booking[]
  managers          ServiceManager[]

  @@map("services")
}

// Gestionnaires nominatifs d'un service (relation N-N user <-> service).
// Remplit la colonne "Structure / Service" pour les comptes gestionnaires.
model ServiceManager {
  userId    String
  serviceId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@index([serviceId])
  @@map("service_manager")
}

model Slot {
  id           String     @id
  serviceId    String
  slotType     SlotType   @default(recurring)
  startTime    String     @default("09:00")
  endTime      String     @default("10:30")
  slotDate     DateTime?  @db.Date
  // Jour de la semaine pour un créneau récurrent (un slot = un jour).
  // null pour les créneaux `unique` : le jour se déduit de slotDate.
  // CHECK ck_slots_recurrent_complet (SQL brut, NOT VALID — migration 20260724190000,
  // inexprimable en Prisma) : un récurrent DOIT avoir periodId ET slotDay.
  slotDay      DayOfWeek?
  /// Créneau RÉCURRENT limité à une partie de sa période (ex. activité qui démarre
  /// après la Toussaint). Nulles = toute la période. La période reste la borne
  /// extérieure : les dates sont rognées sur elle, et si le recouvrement devient vide
  /// (période déplacée ailleurs) le créneau retombe sur la période entière plutôt que
  /// de devenir invisible. Source unique de la règle : lib/slot-range.ts.
  dateStart    DateTime?  @db.Date
  dateEnd      DateTime?  @db.Date
  capacity     Int?
  periodId     Int?
  parentSlotId String?
  // Lot de créneaux ponctuels créés en un seul geste « multi » (même jour de semaine
  // répliqué sur la période) : identifiant commun (null hors multi). Permet la
  // suppression / l'édition « toute la série » de façon fiable, indépendamment de l'UI.
  batchId      String?
  weeks        String?
  // « A une jauge » : posé À LA CRÉATION selon le mode jauge de l'agenda admin
  // (icône capsule) ; les miroirs héritent du récurrent parent.
  jauge        Boolean    @default(false)
  // Alimente la « version d'agenda » du polling des grilles (max(updatedAt) + count,
  // cf. /api/agenda-version) — audit perf 2026-07-24.
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz

  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  period     Period?         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  demandeurs SlotDemandeur[]
  bookings   Booking[]
  // Self-FK : un créneau MIROIR (slotType=unique, daté) référence son créneau
  // récurrent parent. Supprimer le parent supprime ses miroirs (cascade DB) — la
  // suppression manuelle dans slots.ts reste un no-op idempotent.
  parent     Slot?           @relation("SlotMirrors", fields: [parentSlotId], references: [id], onDelete: Cascade)
  mirrors    Slot[]          @relation("SlotMirrors")

  @@index([serviceId])
  @@index([parentSlotId])
  @@index([periodId])
  @@index([batchId])
  // Cron de rappels (filtre slotDate, quotidien sur tous les slots) et plage de
  // dates des éditions.
  @@index([slotDate])
  @@map("slots")
}

// Exercice = cadre temporel d'un service, créé EXPLICITEMENT avant ses périodes
// (libellé, type civile/scolaire, dates de début/fin). Les périodes s'y rattachent et
// doivent tomber dans [dateStart, dateEnd]. Propre à un service (serviceId).
model Exercice {
  id        Int          @id @default(autoincrement())
  // CHECK ck_exercice_service_requis (SQL brut, NOT VALID — migration 20260724190000,
  // inexprimable en Prisma) : toute NOUVELLE ligne doit porter un serviceId.
  serviceId String?
  label     String
  type      ExerciceType @default(scolaire)
  dateStart DateTime?    @db.Date
  dateEnd   DateTime?    @db.Date
  createdAt DateTime     @default(now()) @db.Timestamptz

  // Réglages d'ouverture DE L'EXERCICE — source unique (le service n'en porte plus).
  // Édités dans Paramètres > Périodes et réservations, copiés par la bascule
  // d'exercice. Une date couverte par aucun exercice est FERMÉE (opening.ts).
  morningStart         String  @default("09:00")
  morningEnd           String  @default("12:00")
  afternoonStart       String  @default("14:00")
  afternoonEnd         String  @default("18:00")
  activeDays           String  @default("lun,mar,mer,jeu,ven")
  openOnHolidays       Boolean @default(false)
  openOnSchoolHolidays Boolean @default(false)

  // « Affiché aux utilisateurs » : l'UNIQUE exercice du service accessible côté
  // usager (unicité par service maintenue par l'application, cf. periods.ts).
  visibleToUsers Boolean @default(false)

  // Maximums de réservation PAR USAGER, portés par l'exercice (copiés par la
  // bascule) : maxReservationsPeriod = par période, maxReservations = sur
  // l'exercice entier (« par an » — nommage legacy conservé).
  maxReservations       Int @default(1)
  maxReservationsPeriod Int @default(1)

  // Délai limite de réservation PAR EXERCICE (déplacé du service). Encodage legacy :
  // 0 = aucun délai, <0 = jours ouvrés, ≥1000 = jours calendaires (cf. lib/booking-delay).
  bookingDelay Int @default(0)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  periods Period[]

  @@index([serviceId])
  @@map("exercice")
}

model Period {
  id            Int       @id @default(autoincrement())
  // Toujours rattachée à un service (plus de « périodes globales » serviceId null).
  serviceId     String
  exerciceId    Int?
  label         String
  etiquette     String?
  // Nullable À DESSEIN : période en cours de saisie, ou reconduite par la bascule
  // quand le décalage d'un an échoue (29 février) — le moteur de miroirs les ignore.
  // CHECK ck_periods_dates_ordonnees (SQL brut, NOT VALID — migration 20260724190000) :
  // dateStart <= dateEnd quand les deux sont présentes.
  dateStart     DateTime? @db.Date
  dateEnd       DateTime? @db.Date
  // Disponibilité : date à partir de laquelle les USAGERS peuvent réserver sur
  // cette période. Vide = réservable sans restriction de date.
  // (Colonne renommée « Disponibilite » → « disponibilite » — plus de casse mixte.)
  disponibilite DateTime? @db.Date
  color         String    @default("#6dceaa")
  position      Int       @default(0)

  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  exercice Exercice?       @relation(fields: [exerciceId], references: [id], onDelete: SetNull)
  slots    Slot[]
  bookings Booking[]
  holidays PeriodHoliday[]

  @@index([serviceId])
  @@index([exerciceId])
  @@map("periods")
}

model CycleEvent {
  id        Int      @id @default(autoincrement())
  serviceId String?
  createdAt DateTime @default(now()) @db.Timestamptz
  data      Json

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@map("cycle_events")
}

model PeriodHoliday {
  id       Int      @id @default(autoincrement())
  periodId Int
  date     DateTime @db.Date
  label    String   @default("")

  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, date])
  @@map("period_holidays")
}

model SchoolHoliday {
  id        Int      @id @default(autoincrement())
  zone      String   @db.Char(1)
  dateStart DateTime @db.Date
  dateEnd   DateTime @db.Date
  label     String   @default("")

  @@index([zone, dateStart, dateEnd])
  @@map("school_holidays")
}

model Demandeur {
  id                   Int     @id @default(autoincrement())
  label                String
  openOnSchoolHolidays Boolean @default(true)
  /// Catégorie fourre-tout (« Autres ») : l'usager SAISIT sa structure à l'inscription
  /// au lieu de la choisir dans une liste. Le libellé saisi devient une `Structure` de
  /// cette catégorie — les écrans qui affichent une structure (agenda, éditions,
  /// statistiques, exports) fonctionnent donc sans rien savoir de ce mode, et
  /// l'administration peut renommer ou fusionner ces entrées comme les autres.
  /// Ces structures ne sont JAMAIS proposées au public : le formulaire reste en
  /// saisie libre pour cette catégorie (sans quoi chacun lirait la liste de ce que
  /// les précédents ont déclaré).
  structureLibre       Boolean @default(false)

  structures       Structure[]
  niveaux          Niveau[]
  slotRestrictions SlotDemandeur[]
  serviceSettings  ServiceDemandeurSettings[]
  users            User[]

  @@map("demandeurs")
}

model Structure {
  id          Int    @id @default(autoincrement())
  demandeurId Int
  label       String

  demandeur Demandeur @relation(fields: [demandeurId], references: [id], onDelete: Cascade)
  users     User[]

  @@index([demandeurId])
  @@map("structures")
}

model Niveau {
  id          Int    @id @default(autoincrement())
  label       String
  demandeurId Int?
  position    Int    @default(0)

  demandeur Demandeur? @relation(fields: [demandeurId], references: [id], onDelete: SetNull)

  @@index([demandeurId])
  @@map("niveaux")
}

model SlotDemandeur {
  slotId      String
  demandeurId Int

  slot      Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  demandeur Demandeur @relation(fields: [demandeurId], references: [id], onDelete: Cascade)

  @@id([slotId, demandeurId])
  @@index([demandeurId])
  @@map("slot_demandeurs")
}

model ServiceTheme {
  id        Int    @id @default(autoincrement())
  serviceId String
  label     String
  position  Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_themes")
}

model ServiceDemandeurSettings {
  serviceId   String
  demandeurId Int
  validation  Boolean @default(false)
  themes      Boolean @default(false)
  /// Le thème devient OBLIGATOIRE : l'usager ne peut pas enregistrer sans l'avoir
  /// renseigné. Sans effet si `themes` est éteint — le champ n'est alors pas affiché.
  themeRequired Boolean @default(false)
  // (La jauge est portée par CHAQUE CRÉNEAU — slots.jauge. Le mode récurrent et
  // l'alternance A/B sont GLOBAUX au service — Service.recurrentMode/semaineAb.)

  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  demandeur Demandeur @relation(fields: [demandeurId], references: [id], onDelete: Cascade)

  @@id([serviceId, demandeurId])
  @@index([demandeurId])
  @@map("service_demandeur_settings")
}

model Booking {
  id              Int         @id @default(autoincrement())
  bookingType     BookingType @default(recurring)
  userId          String
  serviceId       String
  slotId          String
  // null = aucune période (réservation ponctuelle autonome ou enfant d'occurrence) ;
  // sinon FK vers la période (réservation récurrente). L'unicité uq_recurring est créée
  // en NULLS NOT DISTINCT (migration brute) pour que les lignes à periodId NULL restent
  // dédupliquées — Prisma ne sait pas exprimer NULLS NOT DISTINCT dans le schéma.
  periodId        Int?
  week            String      @default("")
  parentBookingId Int?
  themeLabel      String      @default("")
  // Snapshot de la fiche usager À LA CRÉATION (même principe que themeLabel) :
  // structure, catégorie (demandeur) et niveau au moment de la réservation. Les
  // statistiques lisent CES colonnes — un changement ultérieur de la fiche (Mon
  // compte, admin) ne réécrit plus la répartition des exercices passés.
  // "" = non renseigné à la création.
  structureLabel  String      @default("")
  demandeurLabel  String      @default("")
  niveauLabel     String      @default("")
  enfants         Int         @default(0) @db.SmallInt
  accompagnants   Int         @default(0) @db.SmallInt
  validated       Boolean     @default(false)
  createdAt       DateTime    @default(now()) @db.Timestamptz
  // Alimente la « version d'agenda » du polling des grilles (max(updatedAt) + count,
  // cf. /api/agenda-version) — audit perf 2026-07-24.
  updatedAt       DateTime    @default(now()) @updatedAt @db.Timestamptz

  // Point de départ du décompte d'auto-validation (= createdAt, MAJ sur déplacement).
  autoValidateFrom DateTime? @db.Timestamptz
  // Horodatage de l'auto-validation (null = jamais auto-validée). Sert au digest de
  // notification des gestionnaires (cf. services/manager-notice.ts).
  autoValidatedAt  DateTime? @db.Timestamptz
  pointage         Pointage?
  // Motif d'absence (facultatif, saisi dans la fiche réservation) : AFFICHÉ seulement
  // lorsque pointage = absent, mais CONSERVÉ si le pointage change — il réapparaît si
  // l'absence est réactivée. Effacé uniquement à l'anonymisation RGPD.
  pointageMotif    String    @default("")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slot      Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  period    Period?           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  reminders BookingReminder[]
  // Réservation récurrente « parente » → réservations-enfants datées (une par
  // occurrence, bookingType=unique). Supprimer le parent supprime ses enfants.
  parent    Booking?          @relation("BookingChildren", fields: [parentBookingId], references: [id], onDelete: Cascade)
  children  Booking[]         @relation("BookingChildren")

  @@unique([userId, serviceId, slotId, periodId, week], name: "uq_recurring")
  @@index([userId])
  @@index([periodId])
  @@index([slotId])
  @@index([parentBookingId])
  // File d'auto-validation par service (auto-validate.ts) + agrégats stats validés.
  @@index([serviceId, validated])
  // Digest gestionnaire : range scan des auto-validations d'un service (manager-notice.ts).
  @@index([serviceId, autoValidatedAt])
  // Éditions/exports : filtre serviceId + tri (periodId, createdAt) sans tri en mémoire
  // (editions.ts). Couvre aussi les lookups serviceId seul (préfixe gauche) → l'index
  // [serviceId] simple devient redondant et a été retiré.
  @@index([serviceId, periodId, createdAt])
  @@map("bookings")
}

// Journal des rappels de réservation déjà envoyés : garantit l'idempotence du cron
// (un rappel J-7 et un rappel J-1 au maximum par occurrence). `slotDate` = date de
// l'occurrence concernée ; `kind` = "week" (J-7) ou "day" (J-1).
model BookingReminder {
  id        Int      @id @default(autoincrement())
  bookingId Int
  slotDate  DateTime @db.Date
  kind      String
  sentAt    DateTime @default(now()) @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, slotDate, kind])
  @@index([slotDate])
  @@map("booking_reminders")
}

// Journal d'audit RGPD — pas de FK : conservé même après anonymisation/suppression.
model RgpdLog {
  id           Int      @id @default(autoincrement())
  action       String
  targetUserId String?
  actorUserId  String?
  details      Json?
  ip           String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([action])
  @@index([targetUserId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("rgpd_log")
}

model AppConfig {
  key   String  @id @map("cfg_key")
  value String? @map("cfg_value")

  @@map("app_config")
}

// File d'attente des e-mails en échec (envoi best-effort) : conservés pour pouvoir
// les renvoyer depuis Administration > Messagerie. Pas de FK (destinataire libre).
model FailedMail {
  id          Int      @id @default(autoincrement())
  toAddr      String   @map("to_addr")
  subject     String   @default("")
  html        String   @default("")
  text        String   @default("")
  error       String   @default("")
  attempts    Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now()) @db.Timestamptz
  lastTriedAt DateTime @default(now()) @map("last_tried_at") @db.Timestamptz

  @@index([createdAt])
  @@map("failed_mails")
}

// Référentiel des déclencheurs d'e-mails de réservation (actions métier affichées dans
// « Échanges par mail »). La CLÉ reste le contrat avec le code (chaque déclencheur
// correspond à un point d'envoi précis) ; seuls le libellé, le type d'e-mail par défaut
// et l'ordre d'affichage sont des données. Peuplé au seed (cf. defaultMailTriggers()).
model MailTrigger {
  key         String   @id
  label       String
  defaultKind String   @map("default_kind")
  position    Int      @db.SmallInt
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@map("mail_triggers")
}

// Table UNIQUE des types d'e-mails (métadonnées + contenu), toutes portées confondues.
// Clé composite (serviceId, key) : `serviceId = ""` ⇒ niveau GLOBAL (intégrés + types perso
// globaux) ; `serviceId = "<svc>"` ⇒ entrée propre à un service (type perso du service, ou
// SURCHARGE de contenu d'un type intégré). Les métadonnées (label/description/recipient/
// builtin/system/position) font foi sur la ligne globale ; les lignes par service ne portent
// que le contenu (subject/html). Lecture du contenu en cascade : (svc,key) → ("",key) → défaut
// code (DEFAULT_TEMPLATES, repli de sûreté). Les CLÉS intégrées restent un contrat avec le code.
// Routage / envoi / destinataire par action et SMTP restent dans app_config (ce sont des réglages).
model MailType {
  serviceId   String   @default("") @map("service_id")
  key         String
  label       String   @default("")
  description String   @default("")
  recipient   String   @default("")
  subject     String   @default("")
  html        String   @default("")
  builtin     Boolean  @default(false)
  system      Boolean  @default(false)
  position    Int      @default(0) @db.SmallInt
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@id([serviceId, key])
  @@map("mail_types")
}

// Freinage des tentatives de connexion PAR COMPTE (constat A1, audit 2026-07-29).
// Le quota de Better Auth est calé sur l'IP : il ne voit pas le password spraying,
// où chaque tentative vise un compte différent. Cf. src/server/login-throttle.ts.
//
// Indexée sur un HMAC de l'adresse, jamais sur l'adresse elle-même :
//  - le freinage s'applique à l'identique que le compte existe ou non, sinon la
//    différence de comportement révélerait les adresses inscrites ;
//  - on n'accumule pas les adresses de gens qui se sont trompés de site.
model LoginAttempt {
  emailHash     String    @id @map("email_hash")
  failures      Int       @default(0) @db.SmallInt
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  lastFailureAt DateTime  @default(now()) @map("last_failure_at") @db.Timestamptz

  // Purge des compteurs périmés (tâche de rétention).
  @@index([lastFailureAt])
  @@map("login_attempts")
}

// Quota par IP de Better Auth, persisté en base plutôt qu'en mémoire.
// En mémoire, un simple redémarrage du conteneur remettait tous les compteurs à
// zéro : il suffisait d'attendre un déploiement pour repartir avec un quota neuf
// (constat A3). Le schéma est imposé par Better Auth (clé, compteur, horodatage).
model RateLimit {
  // `id` est INDISPENSABLE : l adaptateur Prisma de Better Auth en genere un pour
  // tout enregistrement cree. Sans ce champ, chaque ecriture du quota echoue sur
  // « Unknown argument id » — et donc TOUTE tentative de connexion. La cle
  // fonctionnelle est `key`, en index unique.
  id          String @id @default(cuid())
  key         String @unique
  count       Int    @default(0)
  lastRequest BigInt @default(0) @map("last_request")

  @@map("rate_limits")
}

// Journal des actions PRIVILÉGIÉES (constat BAC4, audit 2026-07-29).
//
// Distinct de `RgpdLog`, et volontairement : celui-ci est un registre à finalité
// JURIDIQUE (droits des personnes, art. 15 et 17) ; celui-là est un journal
// OPÉRATIONNEL de sécurité. Les confondre reviendrait à noyer les demandes
// d'exercice de droits sous les opérations d'exploitation, et inversement.
//
// Ce qui manquait : changement de rôle, restauration ou téléchargement de
// sauvegarde, modification des identifiants SMTP, suppression de service — soit
// exactement les actes qu'on cherche à reconstituer après un incident.
//
// L'acteur est DÉNORMALISÉ (libellé + rôle au moment de l'acte) : un journal qui
// perd son sens quand le compte est supprimé ou anonymisé ne sert à rien le jour
// où l'on en a besoin. C'est aussi pourquoi il n'y a pas de clé étrangère.
model AuditLog {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz
  action     String
  actorId    String?  @map("actor_id")
  actorLabel String   @default("") @map("actor_label")
  actorRole  String   @default("") @map("actor_role")
  target     String?
  details    Json?
  ip         String?

  @@index([at])
  @@index([action])
  @@index([actorId])
  @@map("audit_log")
}

// Second facteur TOTP (constat A6, audit 2026-07-29). Schéma imposé par le plugin
// twoFactor de Better Auth : les NOMS DE CHAMPS Prisma font contrat avec lui, seuls
// les noms de colonnes sont libres.
//
// `id` est indispensable : l'adaptateur en génère un pour tout enregistrement créé.
// Son absence sur `rate_limits` avait provoqué une panne complète de
// l'authentification — la même erreur ne doit pas être commise deux fois.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

// ── Constat A3 : compteurs hors périmètre Better Auth, persistés ────────────────
//
// A1 avait traité les deux compteurs qui protègent l'AUTHENTIFICATION (`rate_limits`,
// `login_attempts`). Ceux-ci en restaient exclus et vivaient en mémoire de processus :
// un simple `docker compose restart` — ou un déploiement — les remettait à zéro, et
// deux réplicas auraient eu chacun le sien.

/// Seaux de la limitation de débit hors Better Auth (génération de captcha, demande
/// de suppression de compte). Fenêtre fixe : `count` remis à 1 quand `resetAt` est
/// dépassé. La clé porte déjà sa portée (`captcha:<ip>`, `acct-del:<userId>`).
model ThrottleBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at") @db.Timestamptz

  // Purge des seaux périmés (tâche de rétention).
  @@index([resetAt])
  @@map("throttle_buckets")
}

/// Nonces de captcha déjà consommés (anti-rejeu). La CONSOMMATION est l'insertion
/// elle-même : une violation de clé primaire signifie « déjà servi ». Vérifier puis
/// écrire laisserait deux requêtes simultanées passer avec le même token.
model CaptchaNonce {
  nonce     String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("captcha_nonces")
}
